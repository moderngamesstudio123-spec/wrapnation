# Database Configuration (Supabase PostgreSQL)
# Recommended Region for India: Supabase Mumbai (ap-south-1) & Vercel Function Region Mumbai (bom1)
# Pooler URL for transactions / application queries (port 6543)
DATABASE_URL="postgresql://postgres.[project-ref]:[password]@aws-0-ap-south-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
# Direct URL for Prisma migrations & schema changes (port 5432)
DIRECT_URL="postgresql://postgres:[password]@db.[project-ref].supabase.co:5432/postgres"

# Security & Sessions (Must rotate in production - minimum 32 chars)
SESSION_SECRET="wrap_nation_session_secret_change_in_production_min_32_chars!"
HMAC_SECRET="wrap_nation_table_hmac_secret_key_must_be_random_and_secure!"

# Cron Endpoint Security (Vercel Cron sends Authorization: Bearer <CRON_SECRET>)
CRON_SECRET="wrap_nation_cron_secret_random_secure_key_here"

# Print Agent Authentication
PRINTER_AGENT_RAW_KEY="wn_print_agent_secret_key_prod_80mm"

# WhatsApp Business Cloud API (Optional - falls back to Mock provider when empty)
META_WA_PHONE_NUMBER_ID=""
META_WA_ACCESS_TOKEN=""
META_WA_WEBHOOK_VERIFY_TOKEN=""
META_WA_APP_SECRET=""

# Application
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"
PORT="3000"
